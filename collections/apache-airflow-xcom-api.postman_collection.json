          "id": "f50d30bf-0b24-42c7-b1a8-d6aad942437b",
          "name": "Apache Airflow List XCom Entries",
          "request": {
            "name": "Apache Airflow List XCom Entries",
            "description": {
              "content": "This endpoint allows specifying `~` as the dag_id, dag_run_id, task_id to retrieve XCOM entries for for all DAGs, DAG runs and task instances. XCom values won't be returned as they can be large. Use this endpoint to get a list of XCom entries and then fetch individual entry to get value.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "dags",
                ":dag_id",
                "dagRuns",
                ":dag_run_id",
                "taskInstances",
                ":task_id",
                "xcomEntries"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "100",
                  "description": "The numbers of items to return."
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "<integer>",
                  "description": "The number of items to skip before starting to collect the result set."
