{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/api-evangelist/apache-airflow/refs/heads/main/json-schema/openapi.yaml-x-com-collection-item-schema.json",
  "title": "XComCollectionItem",
  "description": "XCom entry collection item.\n\nThe value field is only available when reading a single object due to the size of the value.\n",
