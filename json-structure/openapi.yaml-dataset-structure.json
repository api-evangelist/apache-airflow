{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://raw.githubusercontent.com/api-evangelist/apache-airflow/refs/heads/main/json-structure/openapi.yaml-dataset-structure.json",
  "name": "Dataset",
  "description": "A dataset item.\n\n*New in version 2.4.0*\n",
  "type": "object",
  "properties": {
    "consuming_dags": {
      "items": {
        "$ref": "#/components/schemas/DagScheduleDatasetReference"
      },
      "type": "array"
    },
    "created_at": {
      "description": "The dataset creation time",
      "nullable": false,
      "type": "string"
    },
    "extra": {
      "description": "The dataset extra",
      "nullable": true,
      "type": "object"
    },
    "id": {
      "description": "The dataset id",
      "type": "integer"
    },
    "producing_tasks": {
      "items": {
        "$ref": "#/components/schemas/TaskOutletDatasetReference"
      },
      "type": "array"
    },
    "updated_at": {
      "description": "The dataset update time",
      "nullable": false,
      "type": "string"
    },
    "uri": {
      "description": "The dataset uri",
      "nullable": false,
      "type": "string"
    }
  }
}