{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/api-evangelist/apache-airflow/refs/heads/main/json-schema/openapi.yaml-dataset-collection-schema.json",
  "title": "DatasetCollection",
  "description": "A collection of datasets.\n\n*New in version 2.4.0*\n",
  "type": "object",
  "allOf": [
    {
      "properties": {
        "datasets": {
          "items": {
            "$ref": "#/components/schemas/Dataset"
